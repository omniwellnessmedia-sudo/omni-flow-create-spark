# Example environment file. Copy to .env.local and fill in.
# Never commit real credentials. This file holds names and comments only.

# Seed catalogue gate (src/config/seedCatalogue.ts).
# The two seed product files ship placeholder links (example.com and "#")
# that cannot earn a commission, so they are off unless this is set to the
# literal string "true". MUST remain unset in production.
VITE_ENABLE_SEED_CATALOGUE=

# Optional additional GA4 measurement ID. The live install is hardcoded in
# index.html; this is only needed to send to a second or replacement stream.
VITE_GA4_ID=

# Viator affiliate attribution (src/config/programmes.ts).
# Both come from the Viator partner dashboard. They are not secrets, but they
# are account specific, so they are never hardcoded. Until BOTH are set in
# Netlify, buildViatorLink returns the bare URL and logs an error: the link
# still works, it simply cannot be attributed and will not be paid out.
VITE_VIATOR_PID=
VITE_VIATOR_MCID=
