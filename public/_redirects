# Netlify reads this file BEFORE netlify.toml and stops at the first match, so
# anything that must beat the SPA catch-all has to live here, above it.
# Keep these in sync with the [[redirects]] blocks in netlify.toml.

# Canonical host: www 301s to the apex that the site, every canonical tag and
# every Ads final URL use. Ad clicks must not land on a redirect chain.
https://www.omniwellnessmedia.co.za/*  https://omniwellnessmedia.co.za/:splat  301!

# Real 301 for the duplicate event URL. It had no route behind it, so it was
# served as an indexable soft 404 at HTTP 200.
/community/events/stunning-pigs  /events/stunning-pigs  301!

# Certificate register — permanent URLs printed on physical certificates.
# Served by netlify/functions/awards.mjs (which also declares these paths in
# its own config); these rules exist so the SPA catch-all below can never
# shadow them. Do not remove or reorder.
/awards            /.netlify/functions/awards   200
/awards/*          /.netlify/functions/awards   200

# Canonical tour URLs. The /tour-detail/ fork duplicated every tour page at a
# second URL; crawlers now get a real 301 to the /tours/ canonical. Order
# matters: these sit above the SPA catch-all.
/tour-detail/*  /tours/:splat  301!

# Commerce collapse (see REVENUE_ENGINE_REPORT.md): listing surfaces fold into
# /marketplace, connectivity surfaces into /roambuddy-store. /store/product/*
# deliberately has no rule here so product deep links keep resolving.
/store/collections/*        /marketplace      301!
/store                      /marketplace      301!
/wellness-deals             /marketplace      301!
/esim-store                 /roambuddy-store  301!
/wellness-roaming-packages  /roambuddy-store  301!

/*    /index.html   200
