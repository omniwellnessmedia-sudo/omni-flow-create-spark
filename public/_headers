/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Static image directories — pure asset paths, no SPA route behind them.
# Keep in sync with netlify.toml.
/branding/*
  Cache-Control: public, max-age=31536000, immutable

/lovable-uploads/*
  Cache-Control: public, max-age=31536000, immutable

/events/wwpl/*
  Cache-Control: public, max-age=31536000, immutable

# /events/* is NOT wildcarded: "/events/stunning-pigs" is a real SPA route that
# must keep serving fresh index.html. Only the image files are listed, by exact
# name, so a year-long cache can never strand the page itself.
/events/wwpl-square.png
  Cache-Control: public, max-age=31536000, immutable

/events/wwpl-square.webp
  Cache-Control: public, max-age=31536000, immutable

/events/rda_square_1200x1200.png
  Cache-Control: public, max-age=31536000, immutable
