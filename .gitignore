# Large media files - use external storage/CDN
Omni-Wellness-Images/
public/images/
*.png
*.jpg
*.jpeg
*.gif
*.tif
*.webp
*.ARW
*.pdf
# Exception: small tracked brand assets (nav/footer logo mark) — not bulk media
!public/branding/*.png
# Exception: official event artwork (small web-size files only).
# .webp must be listed explicitly — the blanket *.webp above would otherwise
# silently drop the optimised posters from the deploy and leave the page
# serving the much heavier PNG fallback.
!public/events/*.png
!public/events/*.jpg
!public/events/*.webp
# Makeover asset set (optimised WebP crops of the official commissioned artwork)
!public/events/wwpl/*.webp
!public/events/wwpl/*.jpg
# Event partner logos and CLEARED awardee cards (small optimised webp only).
# These folders hold web-size assets by construction — anything heavy stays
# in Drive. Without these exceptions the blanket *.webp above silently drops
# the partner logos and honouree cards from the deploy.
!public/partners/*.webp
!public/awardees/*.webp
# Ceremony pack portraits (the deck references png paths)
!public/events/wwpl/ceremony-mq7v3/assets/honourees/*.png
# BWC staging photographs. ONLY the two files the pack's register marks
# APPROVED are tracked; the review-only fallbacks are not in this repo at all.
!public/team/bwc/*.webp

# Local Netlify folder
.netlify

# Secrets & credentials — never commit these
LOGIN_CREDENTIALS.md
*.credentials
credentials.*
.env.local
.env.*.local
